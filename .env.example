# このファイルをコピーして .env を作り、値を入れてください（.env はGitHubに上げません）
#   cp .env.example .env

# Supabase の Project URL（Project Settings → API）
EXPO_PUBLIC_SUPABASE_URL=

# Supabase の anon public キー（公開用。アプリに入れてよいのはこれだけ）
# ⚠️ service_role キーは絶対にここに書かないこと
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# demo にすると、Supabase接続後もデモデータだけを表示します
EXPO_PUBLIC_APP_ENV=demo
